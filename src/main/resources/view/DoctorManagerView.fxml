<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.doctormanagerviewcontroller">
   <children>
      <TextField fx:id="txtID" layoutX="55.0" layoutY="88.0" promptText="ID" />
      <TextField fx:id="txtContact" layoutX="392.0" layoutY="213.0" promptText="contact details" />
      <TextField fx:id="txtSpeciality" layoutX="55.0" layoutY="144.0" promptText="specialty" />
      <TextField fx:id="txtAvailabilty" layoutX="392.0" layoutY="144.0" promptText="availabilty" />
      <TextField fx:id="txtName" layoutX="392.0" layoutY="88.0" promptText="name" />
      <TextArea fx:id="txtQuali" layoutX="55.0" layoutY="213.0" prefHeight="95.0" prefWidth="237.0" promptText="qualifications" />
      <Label alignment="CENTER" layoutX="2.0" layoutY="6.0" prefHeight="44.0" prefWidth="590.0" text="Manage Doctor">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <Button fx:id="BtnAdd" layoutX="297.0" layoutY="345.0" mnemonicParsing="false" onAction="#BtnOnActionAdd" text="Add" />
      <Button fx:id="BtnSearch" layoutX="501.0" layoutY="345.0" mnemonicParsing="false" onAction="#BtnOnActionSearch" text="Search" />
      <Button fx:id="BtnUpdate" layoutX="429.0" layoutY="345.0" mnemonicParsing="false" onAction="#BtnOnActionUpdate" text="Update" />
      <Button fx:id="BtnDlt" layoutX="352.0" layoutY="345.0" mnemonicParsing="false" onAction="#BtnOnActionDelete" text="Delete" />
   </children>
</AnchorPane>
