<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.AppointmentViewController">
   <children>
      <ComboBox fx:id="DropPatientId" layoutX="45.0" layoutY="34.0" prefWidth="150.0" promptText="Patient ID" />
      <ComboBox fx:id="DropDoctorId" layoutX="375.0" layoutY="34.0" prefWidth="150.0" promptText="Doctor ID" />
      <Label fx:id="lblPatientName" layoutX="45.0" layoutY="85.0" prefHeight="32.0" prefWidth="150.0" text="Patient Name" />
      <Label fx:id="lblDoctorName" layoutX="375.0" layoutY="85.0" prefHeight="32.0" prefWidth="150.0" text="Doctor Name" />
      <Button fx:id="BtnBook" layoutX="464.0" layoutY="331.0" mnemonicParsing="false" onAction="#BtnActionBook" prefHeight="26.0" prefWidth="68.0" text="Book" />
      <TextField fx:id="txtID" layoutX="40.0" layoutY="166.0" promptText="Appointment Id" />
      <TextField fx:id="txtTime" layoutX="40.0" layoutY="263.0" promptText="time" />
      <TextField fx:id="txtDate" layoutX="40.0" layoutY="217.0" promptText="Date" />
   </children>
</AnchorPane>
